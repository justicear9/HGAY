# Clean URLs: hide index.html and strip .html / .php from browser URLs.
# Works at domain root or in a subfolder (no hardcoded /HGAY/ path).
<IfModule mod_rewrite.c>
  RewriteEngine On

  <IfModule mod_negotiation.c>
    Options -MultiViews
  </IfModule>

  # --- Clean URL routing (before -f/-d so /admin is not blocked by admin/ folder) ---
  RewriteRule ^sitemap\.xml$ sitemap.php [L]
  RewriteRule ^robots\.txt$ robots.php [L]
  RewriteRule ^$ index.php [L]
  RewriteRule ^gallery/?$ gallery.php [L]
  RewriteRule ^fact-check/?$ fact-check.php [L]
  RewriteRule ^events/?$ events.php [L]
  RewriteRule ^verify/?$ verify.php [L,QSA]

  # Hubtel return URLs sent before query-string fix (verify%3Forder%3D123)
  RewriteRule ^verify%3Forder%3D([0-9]+)/?$ verify?order=$1 [R=302,L,QSA,NE]
  RewriteRule ^order-confirmed/?$ order-confirmed.php [L,QSA]
  RewriteRule ^create_order/?$ create_order.php [L]

  RewriteRule ^api/([a-z0-9_-]+)/?$ api/$1.php [L,QSA]

  RewriteRule ^admin/?$ admin/index.php [L]
  RewriteRule ^admin/login/?$ admin/login.php [L]
  RewriteRule ^admin/setup/?$ admin/setup.php [L]
  RewriteRule ^admin/logout/?$ admin/logout.php [L]
  RewriteRule ^admin/seed_fact_cards/?$ admin/seed_fact_cards.php [L,QSA]
  RewriteRule ^admin/seed_gallery/?$ admin/seed_gallery.php [L,QSA]
  RewriteRule ^admin/([a-z0-9_-]+)/?$ admin/$1.php [L,QSA]

  # --- Canonical redirects (strip extensions from browser URL) ---
  RewriteCond %{THE_REQUEST} \s\S+\s+(\S*?)index\.html[\s?] [NC]
  RewriteRule ^index\.html$ %1 [R=301,L]

  RewriteCond %{THE_REQUEST} \s\S+\s+(\S+?)\.html[\s?] [NC]
  RewriteRule \.html$ %1 [R=301,L]

  RewriteCond %{THE_REQUEST} \s\S+\s+(\S+?)/(verify|create_order)\.php[\s?] [NC]
  RewriteRule ^(verify|create_order)\.php$ %1/%2 [R=301,L]

  RewriteCond %{THE_REQUEST} \s\S+\s+(\S+?)/admin/([^.?\s]+)\.php[\s?] [NC]
  RewriteRule ^admin/([^.?\s]+)\.php$ %1/admin/%2 [R=301,L]

  RewriteCond %{THE_REQUEST} \s\S+\s+(\S+?)/api/([^.?\s]+)\.php[\s?] [NC]
  RewriteRule ^api/([^.?\s]+)\.php$ %1/api/%2 [R=301,L]

  # --- Serve real files and directories ---
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
</IfModule>

DirectoryIndex index.php index.html

# Cache static assets (PageSpeed: efficient cache lifetimes)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 week"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType video/mp4 "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|webp|png|jpe?g|gif|svg|mp4)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
